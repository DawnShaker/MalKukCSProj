# Server-only settings. Never use a VITE_ prefix for a Supabase secret.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Verified email of the first manager; never accepted from a sign-up request.
BOOTSTRAP_MANAGER_EMAIL=owner@example.com
# Authentication provider: supabase (existing default) or security (teacher API).
AUTH_PROVIDER=supabase
# For AUTH_PROVIDER=security only. All verification settings stay server-side.
# SECURITY_AUTH_URL=https://your-security-server.example.com
# SECURITY_JWT_KEY=REPLACE_WITH_THE_PRIVATE_KEY_OF_YOUR_SECURITY_SERVER
# SECURITY_JWT_ISSUER=real-estate-security
# SECURITY_JWT_AUDIENCE=real-estate-agency
# BOOTSTRAP_MANAGER_USERNAME=owner@example.com
# A legacy service_role JWT can be used instead of SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=...

# Local development uses an ignored JSON file when Supabase is not configured.
PORT=8888

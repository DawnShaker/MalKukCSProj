# Server-only settings. Never use a VITE_ prefix for a Supabase secret.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# A legacy service_role JWT can be used instead of SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=...

# Local development uses an ignored JSON file when Supabase is not configured.
PORT=8888

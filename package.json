{
  "name": "real-estate-agency",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "test": "node --test server/*.test.mjs",
    "db:import": "node --env-file-if-exists=.env scripts/import-data.mjs",
    "db:prepare": "node scripts/prepare-sql.mjs",
    "db:export": "node --env-file-if-exists=.env scripts/export-data.mjs",
    "security:prepare": "node scripts/prepare-security.mjs",
    "security:start": "node scripts/start-security.mjs",
    "security:check": "node scripts/check-security.mjs",
    "agency:build": "node scripts/build-agency.mjs",
    "agency:start": "node --env-file-if-exists=.env scripts/start-agency.mjs",
    "agency:check": "node scripts/check-agency.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16"
  },
  "dependencies": {
    "jose": "^6.2.17"
  }
}
